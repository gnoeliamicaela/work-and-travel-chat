# Clave de la API de Anthropic para el chat (Claude Haiku 4.5)
ANTHROPIC_API_KEY=

# URLs de los webhooks de n8n. Fire and forget: si fallan o tardan, no
# afectan la respuesta al usuario. Dejarlas vacias desactiva ese envio.
N8N_WEBHOOK_DOWNLOAD_URL=
N8N_WEBHOOK_UNANSWERED_URL=

# Webhook de n8n para la captura de leads (tool collect_lead). A diferencia
# de los de arriba, esta llamada se espera: el resultado se le devuelve a
# Claude como tool_result para que pueda seguir la conversacion.
N8N_LEAD_WEBHOOK_URL=

# Secreto compartido con el workflow de n8n del lead. Se manda en el header
# X-Webhook-Secret para que n8n pueda validar que la llamada viene de aca.
N8N_WEBHOOK_SECRET=
